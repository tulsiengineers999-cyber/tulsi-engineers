# ── Database ─────────────────────────────────────────────
DATABASE_URL=""

# ── App ──────────────────────────────────────────────────
NODE_ENV="development"
APP_NAME="TULSI ENGINEERS"
APP_URL="http://localhost:3000"
AUTH_SECRET=""
SESSION_TTL_HOURS="12"

# ── Storage (LOCAL | S3) ─────────────────────────────────
STORAGE_DRIVER="LOCAL"
LOCAL_STORAGE_PATH="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Email (SMTP) ─────────────────────────────────────────
MAIL_DRIVER="SMTP"   # LOG | SMTP
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"    # Use false with port 587
SMTP_USER="service@tulsiengineers.in"
SMTP_PASSWORD="your-hostinger-mailbox-password"
MAIL_FROM_NAME="TULSI ENGINEERS"
MAIL_FROM_EMAIL="service@tulsiengineers.in"
MAIL_REPLY_TO="service@tulsiengineers.in"

# ── Wapio WhatsApp API ───────────────────────────────────
WHATSAPP_DRIVER="LOG"   # LOG | CLOUD_API
WHATSAPP_PROVIDER="WAPIO"
WHATSAPP_DEFAULT_LANGUAGE="en_US"
WAPIO_ENDPOINT="https://app.wapvio.com/api/v1/send"
WAPIO_INSTANCE_NAME=""
WAPIO_API_KEY=""
WAPIO_TEST_NUMBER=""

# ── OTP ──────────────────────────────────────────────────
OTP_LENGTH="6"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_MAX_RESENDS="3"
OTP_PEPPER=""

# ── Client report links ──────────────────────────────────
CLIENT_LINK_TTL_DAYS="30"

# ── PDF ──────────────────────────────────────────────────
PDF_DRIVER="AUTO"  # AUTO | CHROMIUM | HTML
CHROMIUM_PATH="/opt/pw-browsers/chromium/chrome-linux/chrome"
