# ── Database ─────────────────────────────────────────────
DATABASE_URL=""

# ── App ──────────────────────────────────────────────────
NODE_ENV="development"
APP_NAME="TULSI ENGINEERS"
APP_URL="http://localhost:3000"
AUTH_SECRET=""
SESSION_TTL_HOURS="12"

# ── Storage (LOCAL | S3) ─────────────────────────────────
STORAGE_DRIVER="LOCAL"
LOCAL_STORAGE_PATH="./storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ── Email (SMTP) ─────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="TULSI ENGINEERS"
MAIL_FROM_EMAIL="service@tulsiengineers.example"
MAIL_REPLY_TO=""
MAIL_DRIVER="LOG"   # LOG | SMTP

# ── WhatsApp Business Cloud API ──────────────────────────
WHATSAPP_DRIVER="LOG"   # LOG | CLOUD_API
WHATSAPP_PROVIDER="META" # META | WAPIO
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_DEFAULT_LANGUAGE="en"
WAPIO_ENDPOINT="https://api.wapio.io/api/send-message"
WAPIO_INSTANCE_NAME=""
WAPIO_API_KEY=""

# ── OTP ──────────────────────────────────────────────────
OTP_LENGTH="6"
OTP_TTL_MINUTES="10"
OTP_MAX_ATTEMPTS="5"
OTP_MAX_RESENDS="3"
OTP_PEPPER=""

# ── Client report links ──────────────────────────────────
CLIENT_LINK_TTL_DAYS="30"

# ── PDF ──────────────────────────────────────────────────
PDF_DRIVER="AUTO"  # AUTO | CHROMIUM | HTML
CHROMIUM_PATH="/opt/pw-browsers/chromium/chrome-linux/chrome"
