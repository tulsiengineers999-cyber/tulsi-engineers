# Production Environment Variables for Vercel
# Copy these values to Vercel Dashboard → Project → Settings → Environment Variables

# Database - Get from Neon (neon.tech), Supabase (supabase.com), or Vercel Postgres
DATABASE_URL=""

# App Configuration  
APP_NAME="TULSI ENGINEERS"
APP_URL="https://your-project-name.vercel.app"
NODE_ENV="production"

# Authentication - Use the generated secrets below
AUTH_SECRET="oJ4MB7Dty-Nlp-oI9KrilaWNXIwRc7ZqWT_zlzM4Mmo"
SESSION_TTL_HOURS="12"
OTP_PEPPER="AMaQI8kqvQgQGg4JJKN2qGbELQcGSZhs"

# Storage - Start with LOCAL, upgrade to S3 later if needed
STORAGE_DRIVER="LOCAL"
LOCAL_STORAGE_PATH="./storage"
MAX_UPLOAD_MB="15"

# Email - Start with LOG, configure SMTP later
MAIL_DRIVER="LOG"
MAIL_FROM_NAME="TULSI ENGINEERS"
MAIL_FROM_EMAIL="service@tulsiengineers.com"

# WhatsApp - Start with LOG, configure API later
WHATSAPP_DRIVER="LOG"
WHATSAPP_DEFAULT_LANGUAGE="en"

# Client Links
CLIENT_LINK_TTL_DAYS="30"

# PDF Generation
PDF_DRIVER="AUTO"

# Optional S3 Configuration (for later)
# S3_ENDPOINT=""
# S3_REGION="us-east-1" 
# S3_BUCKET="tulsi-engineers-storage"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_URL=""

# Optional SMTP Configuration (for later)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"

# Optional WhatsApp Configuration (for later)
# WHATSAPP_API_VERSION="v21.0"
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_BUSINESS_ACCOUNT_ID=""
# WHATSAPP_ACCESS_TOKEN=""